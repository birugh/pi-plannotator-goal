{
  "name": "pi-plannotator-goal",
  "version": "0.1.0",
  "type": "module",
  "description": "Universal Goal Adapter: turns an approved Plannotator plan into a pi-goal handoff, for any workflow that follows the Universal Adapter Contract",
  "keywords": [
    "pi-package",
    "pi-extension",
    "plannotator",
    "pi-goal",
    "goals",
    "plan"
  ],
  "files": [
    "index.ts",
    "config.ts",
    "goals-pool.ts",
    "goals.ts",
    "handoff.ts",
    "ir.ts",
    "log.ts",
    "plan-text.ts",
    "types.ts",
    "docs",
    "README.md"
  ],
  "pi": {
    "extensions": ["./index.ts"]
  },
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\""
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "24.19.1",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
